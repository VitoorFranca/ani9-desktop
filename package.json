{
  "name": "ani9-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "App desktop do ANI-9 para macOS: a web do ANI-9 numa janela própria, com notificações, Dock e menus nativos.",
  "license": "MIT",
  "productName": "ANI-9",
  "main": "dist/main.js",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prestart": "install-electron",
    "start": "node build.mjs && electron .",
    "voz:build": "cd native/voz && nice -n 15 cargo build --release -j 2",
    "package": "node package.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "^22.0.0",
    "electron": "45.3.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
